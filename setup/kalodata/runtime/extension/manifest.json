{
  "manifest_version": 3,
  "name": "kalodata",
  "version": "1.0",
  "description": "插件系统",
  "permissions": [
    "proxy",
    "storage",
    "tabs",
    "cookies",
    "activeTab",
    "scripting",
    "webRequest",
    "webRequestAuthProvider",
    "notifications",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.kalodata.com/*"],
      "css": ["style.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
  }
}
